# Copy to apps/web/.env.local. Names only; never commit real values.

# Convex deployment URL (from `npx convex dev`, or the Vercel integration in production).
NEXT_PUBLIC_CONVEX_URL=

# Clerk keys from the Clerk dashboard (API keys page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# PostHog project key (public, phc_…). Leave empty locally so nothing is sent.
NEXT_PUBLIC_POSTHOG_KEY=

# The Beans MCP server's secret for calling convex/mcp.ts. The same value is set
# on the Convex deployment with `npx convex env set MCP_SERVER_SECRET`.
MCP_SERVER_SECRET=

# Local end-to-end tests only. Ignored by production builds.
NEXT_PUBLIC_BEANS_TEST_AUTH=
BEANS_TEST_AUTH=
BEANS_TEST_AUTH_ISSUER=
