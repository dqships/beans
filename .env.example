# Repo root. `npx convex dev` writes CONVEX_DEPLOYMENT, CONVEX_URL and CONVEX_SITE_URL to .env.local.
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# Production builds on Vercel deploy Convex with this key (Convex dashboard, Settings, Deploy keys).
CONVEX_DEPLOY_KEY=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set on the Convex deployment itself with `npx convex env set`, not in this file:
# CLERK_JWT_ISSUER_DOMAIN   Clerk Frontend API URL, or `none` for local test sign-in
# BEANS_TEST_AUTH_ISSUER    Local test sign-in only, for example http://localhost:3000/api/test-auth/
# STRIPE_SECRET_KEY         Stripe restricted key (rk_test_ on dev, rk_live_ on production). Turns the paywall on.
# STRIPE_WEBHOOK_SECRET     Signing secret of the Stripe webhook endpoint for that deployment. See docs/BILLING.md.
